# Neon connection strings (Neon dashboard -> Connect). Replace the placeholders.
# Pooled connection (host contains "-pooler") used by the app at runtime:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler") used by Prisma for `prisma db push`:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
